PORT=3000
DB_USER=cicero
DB_HOST=localhost
DB_NAME=cicero_db
DB_PASS=secret
DB_PORT=5432
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_DRIVER=postgres

# PostgreSQL timeout tuning
# DB_CONNECTION_TIMEOUT_MS: max wait for opening a new DB connection
# DB_QUERY_TIMEOUT_MS: max execution time enforced by pg client
# DB_STATEMENT_TIMEOUT_MS: PostgreSQL statement_timeout per session
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS: PostgreSQL idle_in_transaction_session_timeout per session
ADMIN_WHATSAPP=628xxxxxx,628yyyyyy
GATEWAY_WHATSAPP_ADMIN=628xxxxxx,628yyyyyy
CLIENT_OPERATOR=628123456789
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ADMIN_WHATSAPP=628xxxxxx@c.us
NEXT_PUBLIC_CLIENT_OPERATOR=628123456789
RAPIDAPI_KEY=xxxx
RAPIDAPI_FALLBACK_KEY=
RAPIDAPI_FALLBACK_HOST=tiktok-api6.p.rapidapi.com
REDIS_URL=redis://localhost:6379
ALLOW_DUPLICATE_REQUESTS=false
SECRET_KEY=your-secret
JWT_SECRET=your-jwt-secret
AMQP_URL=amqp://localhost
GATEWAY_WA_CLIENT_ID=wa-gateway-prod
WA_AUTH_DATA_PATH=
WA_AUTH_CLEAR_SESSION_ON_REINIT=false
WA_WEB_VERSION_CACHE_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/versions.json
WA_WEB_VERSION=
WA_WWEBJS_PROTOCOL_TIMEOUT_MS=120000
WA_WWEBJS_PROTOCOL_TIMEOUT_MS_GATEWAY=180000
WA_WWEBJS_PROTOCOL_TIMEOUT_MAX_MS=300000
WA_WWEBJS_PROTOCOL_TIMEOUT_BACKOFF_MULTIPLIER=1.5

# WhatsApp Client Initialization Configuration
WA_INIT_MAX_RETRIES=3
# Maximum number of initialization retries before giving up (default: 3)
WA_INIT_RETRY_DELAY_MS=10000
# Base delay between initialization retries in milliseconds (default: 10000 = 10s)
# Uses exponential backoff: 10s, 20s, 40s, etc.
WA_QR_TIMEOUT_MS=120000
# Timeout for QR code scanning in milliseconds (default: 120000 = 2 minutes)
# After this timeout, the client will retry initialization
WA_ENABLE_BAD_SESSION_RECOVERY=true
# Enable automatic recovery from BAD_SESSION errors (default: true)
# When enabled, BAD_SESSION uses bounded reconnects while preserving auth.
# Session deletion/re-pairing remains an explicit manual recovery action.

# Optional: link using a phone-number code instead of scanning a QR.
# Use international digits only, then restart and read PHONE_PAIRING_CODE in PM2 logs.
DIRECTORATE_WA_PAIRING_PHONE=
OPERATOR_WA_PAIRING_PHONE=
DIRECTORATE_WA_SESSION_NAME=wa-direktorat
OPERATOR_WA_SESSION_NAME=wa-operator

# WhatsApp Client Ready Timeout Configuration
# These timeouts control how long to wait for WhatsApp clients to become ready
# WA_READY_TIMEOUT_MS=180000
# Default timeout for wa-admin client (3 minutes)
# WA_GATEWAY_READY_TIMEOUT_MS=240000
# Timeout for wa-gateway client (4 minutes, longer due to potential higher load)
# WA_AUTH_READY_TIMEOUT_MS=60000
# Timeout after authentication before ready event (1 minute)
# WA_FALLBACK_READY_DELAY_MS=90000
# Delay between fallback readiness checks (1.5 minutes)

# WhatsApp Connection Health Monitoring
# WA_HEALTH_CHECK_INTERVAL_MS=300000
# Interval for periodic health checks (5 minutes)
# Set to 0 to disable health monitoring
GOOGLE_CONTACT_SCOPE=https://www.googleapis.com/auth/contacts
GOOGLE_SERVICE_ACCOUNT=/path/to/service-account.json
GOOGLE_IMPERSONATE_EMAIL=admin@example.com
BACKUP_DIR=./backups
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
DASHBOARD_PASSWORD_RESET_URL=https://papiqo.com/reset-password

# WhatsApp Service Configuration
# WA_SERVICE_SKIP_INIT=false
# WARNING: Setting WA_SERVICE_SKIP_INIT=true will disable WhatsApp message reception
# This should ONLY be used during testing, NEVER in production
# In production, WA_SERVICE_SKIP_INIT=true will cause the service to exit on startup
# When set to true, the bot will NOT receive any messages

# WA_DEBUG_LOGGING=false
# Set to "true" to enable verbose debug logging for message flow
# This is useful for troubleshooting message reception issues
# In production, keep this disabled to reduce log volume

# WA_MESSAGE_DEDUP_TTL_MS=86400000
# Time-to-live for message deduplication cache in milliseconds (default: 24 hours)
# Messages are cached to prevent duplicate processing
# Minimum value: 60000ms (1 minute)
# Older entries are automatically cleaned up every hour
# Adjust based on your expected message volume and memory constraints
